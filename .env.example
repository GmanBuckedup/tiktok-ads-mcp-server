# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- TikTok For Business app credentials ---
# https://business-api.tiktok.com/portal/
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Public URL of the /tiktok/callback endpoint (must match the redirect URI
# configured in the TikTok app).
TIKTOK_REDIRECT_URI=https://your-app.example.com/tiktok/callback

# --- Entra ID (Azure AD) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Usually api://<ENTRA_CLIENT_ID>
ENTRA_AUDIENCE=
# Optional: only needed if the Entra app registration is a confidential client.
ENTRA_CLIENT_SECRET=

# --- MCP server ---
# The server's public base URL, used to build absolute OAuth metadata URLs.
MCP_PUBLIC_URL=https://your-app.example.com
# Optional, comma-separated allowlist of OAuth redirect URIs the proxy will
# deliver authorization codes to. Defaults to Claude.ai's MCP connector
# callbacks if unset.
OAUTH_ALLOWED_REDIRECT_URIS=
# Optional, per-IP request cap (per minute) on the OAuth endpoints. Default 60.
OAUTH_RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
